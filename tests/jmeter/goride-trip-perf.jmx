              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">16</intProp>
            </ResponseAssertion>
            <hashTree />
          </hashTree>
          <SwitchController guiclass="SwitchControllerGui" testclass="SwitchController" testname="Rotate validation cases" enabled="true">
            <stringProp name="SwitchController.value">${__jexl3(${__counter(TRUE,)} % 3)}</stringProp>
          </SwitchController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="fare: invalid input -&gt; 400" enabled="true">
